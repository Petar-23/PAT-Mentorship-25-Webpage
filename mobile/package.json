{
  "name": "pat-mentorship-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "prebuild:ios": "expo prebuild --platform ios --no-install",
    "web": "expo start --web",
    "export:ios": "expo export --platform ios --output-dir dist-ios",
    "export:web": "expo export --platform web --output-dir dist-web && node scripts/offline-shell.mjs",
    "preview": "node scripts/preview.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clerk/expo": "^4.17.3",
    "@expo/metro-runtime": "58.0.17",
    "@expo/ui": "~58.0.29",
    "expo": "~58.0.26",
    "expo-asset": "~58.0.0",
    "expo-auth-session": "~58.0.19",
    "expo-constants": "58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-file-system": "~58.0.0",
    "expo-font": "~58.0.0",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.8",
    "expo-linear-gradient": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-video": "~58.0.0",
    "expo-web-browser": "~58.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "typescript": "~5.9.3"
  }
}
